---
import { site } from '../lib/site';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
	/** 登录页、账号页这类不需要被搜索引擎收录的页面 */
	noindex?: boolean;
	/** 分享卡片类型：文章页传 article */
	type?: 'website' | 'article';
	/** 文章发布时间，写进分享信息 */
	publishedTime?: Date;
}

const { noindex = false, type = 'website', publishedTime } = Astro.props;
const title = Astro.props.title ?? site.title;
const description = Astro.props.description ?? site.description;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
// 分享到 Telegram、X 等处时显示的预览图（方形头像，配 summary 小卡片）
const shareImage = new URL(site.avatar, Astro.site ?? Astro.url);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		{noindex && <meta name="robots" content="noindex" />}
		<meta property="og:type" content={type} />
		<meta property="og:site_name" content={site.title} />
		<meta property="og:locale" content="zh_CN" />
		<meta property="og:url" content={canonical} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={shareImage} />
		<meta property="og:image:alt" content={`${site.name} 的头像`} />
		{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
		<meta name="twitter:card" content="summary" />
		<link rel="alternate" type="application/rss+xml" title={`${site.title} · 文章订阅`} href="/rss.xml" />
		<link rel="icon" href="/favicon.png?v=8" type="image/png" />
		<link rel="icon" href="/favicon.svg?v=8" type="image/svg+xml" />
		<link rel="icon" href="/favicon.ico?v=8" sizes="any" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<ClientRouter />
		<script is:inline>
			document.documentElement.classList.add('js');
		</script>
	</head>
	<body class="page-bg">
		<div id="page-progress" class="page-progress" transition:persist aria-hidden="true"></div>
		<a class="skip-link" href="#main">跳到正文</a>
		<Header />
		<main id="main">
			<slot />
		</main>
		<Footer />
		<div id="toast-host" class="toast-host" aria-live="polite"></div>
		<button class="back-to-top" type="button" data-back-to-top aria-label="回到顶部" transition:name="back-to-top">
			<Icon name="top" />
		</button>
		<script src="../scripts/ui.ts"></script>
	</body>
</html>
