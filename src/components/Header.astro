---
import { nav, site } from '../lib/site';
---

<header class="site-header">
	<div class="header-inner">
		<a class="brand" href="/#top" data-nav-link>
			<svg class="brand-mark" viewBox="0 0 64 64" aria-hidden="true">
				<rect width="64" height="64" rx="16" fill="#FBF7F2"></rect>
				<g fill="#E25C7A">
					<circle cx="32" cy="32" r="5.2"></circle>
					<ellipse cx="32" cy="16.5" rx="7.2" ry="11.5"></ellipse>
					<ellipse cx="32" cy="47.5" rx="7.2" ry="11.5"></ellipse>
					<ellipse cx="16.5" cy="32" rx="11.5" ry="7.2"></ellipse>
					<ellipse cx="47.5" cy="32" rx="11.5" ry="7.2"></ellipse>
				</g>
				<circle cx="32" cy="32" r="3.4" fill="#F7E3C8"></circle>
			</svg>
			{site.name}
		</a>
		<button
			class="nav-toggle"
			type="button"
			data-nav-toggle
			aria-expanded="false"
			aria-controls="site-nav"
			aria-label="打开菜单"
		>
			<span class="nav-toggle-bars"><span></span></span>
		</button>
		<div class="nav-backdrop" data-nav-backdrop></div>
		<nav id="site-nav" class="nav" data-nav-panel aria-label="页面区块">
			{
				nav.map((item) => (
					<a href={item.href} data-nav-link data-section={item.section}>
						{item.label}
					</a>
				))
			}
		</nav>
	</div>
</header>
