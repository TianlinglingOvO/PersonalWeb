---
import { nav, site } from '../lib/site';
---

<header class="site-header">
	<div class="header-inner">
		<a class="brand" href="/#top" data-nav-link>
			<svg class="brand-mark" viewBox="0 0 64 64" aria-hidden="true">
				<rect width="64" height="64" rx="14" fill="#FBF7F2"></rect>
				<rect x="4" y="4" width="56" height="56" rx="12" fill="none" stroke="#E25C7A" stroke-width="2.5"></rect>
				<path
					fill="#E25C7A"
					d="M42.5 18.2c-2.2-2.4-5.2-3.7-9.1-3.7-7.8 0-13 4.6-13 11.2 0 4.4 2.4 7.5 7.2 9.4l3.4 1.3c3.4 1.3 4.9 2.4 4.9 4.5 0 2.5-2.2 4.1-5.6 4.1-3.2 0-5.7-1.4-7.2-4.1l-4.6 2.5c2.4 4.3 6.7 6.7 12 6.7 8.2 0 13.5-4.5 13.5-11.4 0-4.7-2.6-7.9-7.8-9.9l-3.3-1.3c-3-1.2-4.4-2.3-4.4-4.3 0-2.3 2-3.8 5-3.8 2.8 0 4.9 1.2 6.2 3.5l4.8-2.7z"
				></path>
			</svg>
			{site.name}
		</a>
		<button
			class="nav-toggle"
			type="button"
			data-nav-toggle
			aria-expanded="false"
			aria-controls="site-nav"
			aria-label="打开菜单"
		>
			<span class="nav-toggle-bars"><span></span></span>
		</button>
		<div class="nav-backdrop" data-nav-backdrop></div>
		<nav id="site-nav" class="nav" data-nav-panel aria-label="页面区块">
			{
				nav.map((item) => (
					<a href={item.href} data-nav-link data-section={item.section}>
						{item.label}
					</a>
				))
			}
		</nav>
	</div>
</header>
