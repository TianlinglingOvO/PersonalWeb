---
import { nav, site } from '../lib/site';
import Icon from './Icon.astro';
---

<header class="site-header">
	<div class="header-inner">
		<a class="brand" href="/#top" data-nav-link>
			<img class="brand-avatar" src="/images/brand-avatar.jpg?v=8" alt={site.name} width="32" height="32" />
			{site.name}
		</a>
		<button
			class="nav-toggle"
			type="button"
			data-nav-toggle
			aria-expanded="false"
			aria-controls="site-nav"
			aria-label="打开菜单"
		>
			<span class="nav-toggle-bars"><span></span></span>
		</button>
		<div class="nav-backdrop" data-nav-backdrop></div>
		<nav id="site-nav" class="nav" data-nav-panel aria-label="页面区块">
			{
				nav.map((item) => (
					<a href={item.href} data-nav-link data-section={item.section}>
						{item.label}
					</a>
				))
			}
			<div class="nav-mobile-bottom">
				<button type="button" class="btn-close-menu" data-nav-close aria-label="关闭导航菜单">
					<Icon name="close" />
					<span>关闭菜单</span>
				</button>
			</div>
		</nav>
	</div>
</header>
