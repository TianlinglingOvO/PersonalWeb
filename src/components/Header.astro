---
import Icon from './Icon.astro';
import { nav, site } from '../lib/site';

// 文章页没有首页的区块锚点，滚动高亮不会接管，这里直接在 SSR 时点亮“文章”
const isArticlePage = Astro.url.pathname.startsWith('/articles');
---

<header class="site-header" transition:name="site-header">
	<div class="header-inner">
		<a class="brand" href="/#top" data-nav-link>
			<img class="brand-avatar" src="/images/brand-avatar.jpg?v=8" alt={site.name} width="32" height="32" decoding="async" fetchpriority="high" />
			{site.name}
		</a>
		<button
			class="nav-toggle"
			type="button"
			data-nav-toggle
			aria-expanded="false"
			aria-controls="site-nav"
			aria-label="打开菜单"
		>
			<span class="nav-toggle-bars"><span></span></span>
		</button>
		<div class="nav-backdrop" data-nav-backdrop></div>
		<nav id="site-nav" class="nav" data-nav-panel aria-label="页面区块">
			{
				nav.map((item) => (
					<a
						href={item.href}
						class:list={{ 'is-active': isArticlePage && item.section === 'articles' }}
						data-nav-link
						data-section={item.section}
					>
						{item.label}
					</a>
				))
			}
			<!-- 账号入口：默认显示“登录”，ui.ts 的 initAccount 查到登录状态后换成用户名 -->
			<div class="nav-account" data-account>
				<a class="nav-account-login" href="/login/" data-account-login>
					<Icon name="user" class="icon" />登录
				</a>
				<div class="nav-account-user" data-account-user hidden>
					<button
						type="button"
						class="nav-account-chip"
						data-account-toggle
						aria-expanded="false"
						aria-haspopup="menu"
					>
						<span class="nav-account-avatar" data-account-initial aria-hidden="true"></span>
						<span class="nav-account-name" data-account-name></span>
						<span class="role-badge" data-account-admin hidden>站长</span>
					</button>
					<div class="nav-account-menu" data-account-menu role="menu">
						<button type="button" role="menuitem" data-logout>退出登录</button>
					</div>
				</div>
			</div>
		</nav>
	</div>
</header>
