---
import type { CollectionEntry, render } from 'astro:content';
import Icon from './Icon.astro';

interface Props {
	item: CollectionEntry<'timeline'>;
	Content: Awaited<ReturnType<typeof render>>['Content'];
	/** frontmatter 里 article 字段关联的文章（Timeline.astro 查好传进来），卡片上自动生成“阅读文章”按钮 */
	article?: CollectionEntry<'articles'>;
	/** 手机端默认收起的“更早的经历” */
	early?: boolean;
	/** 所在月份经历较多、电脑端要折叠（Timeline.astro 的 FOLD_FROM）：收起时只显示一行“日期 + 标题” */
	foldable?: boolean;
	/** 折叠的月份里默认展开的那一条 */
	open?: boolean;
}

const { item, Content, article, early = false, foldable = false, open = false } = Astro.props;
// 年历和月份标题已经写了年月，卡片上只显示“10月18日”；记不清哪天（只写到月）的显示“10月”
const [year, month, day] = item.data.date.split('.');
const isDate = /^\d{4}$/.test(year);
const dateLabel = !isDate ? item.data.date : month ? `${Number(month)}月${day ? `${Number(day)}日` : ''}` : '全年';
const datetime = isDate ? item.data.date.replaceAll('.', '-') : undefined;
const links = [
	...(article
		? [{ label: `阅读${article.data.category === '教程' ? '教程' : '文章'} →`, href: `/articles/${article.id}/`, isExternal: false, title: article.data.title }]
		: []),
	...item.data.links.map((link) => ({ ...link, title: undefined })),
];
---

{/* id 用于从别处直接定位到这一条：/#tl-文件名（见 scripts/features/timeline.ts） */}
<div
	class:list={['timeline-entry', { 'is-highlight': item.data.isHighlight, 'is-future': item.data.isFuture, 'is-early': early, 'is-open': open }]}
	id={`tl-${item.id}`}
	data-entry={item.id}
>
	<span class="timeline-entry-dot" aria-hidden="true">
		{
			item.data.isFuture && (
				<svg viewBox="0 0 24 24">
					<polygon points="12.0,2.8 14.47,8.6 20.75,9.16 15.99,13.3 17.41,19.44 12.0,16.2 6.59,19.44 8.01,13.3 3.25,9.16 9.53,8.6" />
				</svg>
			)
		}
	</span>
	{
		foldable && (
			<button type="button" class="timeline-entry-row" data-timeline-row aria-expanded="false">
				<span class="timeline-date-badge">{dateLabel}</span>
				<span class="timeline-entry-row-title">{item.data.title}</span>
				<Icon name="chevron-down" class="timeline-entry-row-icon" />
			</button>
		)
	}
	<article class="timeline-micro-card card">
		<div class="timeline-card-header">
			{
				datetime ? (
					<time class="timeline-date-badge" datetime={datetime} title={item.data.date}>
						{dateLabel}
					</time>
				) : (
					<span class="timeline-date-badge">{dateLabel}</span>
				)
			}
			<span class="timeline-tag-badge">{item.data.tag}</span>
		</div>
		<h3 class="timeline-card-title">{item.data.title}</h3>
		<div class="timeline-card-desc">
			<Content />
		</div>
		{
			links.length > 0 && (
				<div class="timeline-card-links">
					{links.map((link) => (
						<a
							href={link.href}
							class="timeline-link-btn"
							title={link.title}
							target={link.isExternal ? '_blank' : undefined}
							rel={link.isExternal ? 'noopener noreferrer' : undefined}
						>
							{link.label}
						</a>
					))}
				</div>
			)
		}
	</article>
</div>
