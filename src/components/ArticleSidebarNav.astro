---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import { formatDate } from '../lib/site';

interface Props {
	currentSlug: string;
	posts: CollectionEntry<'articles'>[];
	class?: string;
}

const { currentSlug, posts, class: className = '' } = Astro.props;
const categories = Array.from(new Set(posts.map((p) => p.data.category).filter(Boolean)));
---

<aside class:list={['article-sidebar-widget', className]} aria-label="文章快速切换导航" data-article-sidebar>
	<div class="sidebar-nav-top">
		<a href="/#articles" class="sidebar-nav-back">
			<Icon name="arrow" />
			<span>返回首页</span>
		</a>
		<a href="/articles/" class="sidebar-nav-all">
			全部 ({posts.length})
		</a>
	</div>

	<div class="sidebar-heading-row">
		<div class="sidebar-nav-heading">
			<Icon name="book" class="sidebar-heading-icon" />
			<span>切换文章</span>
		</div>
		<div class="sidebar-heading-actions">
			<!-- 自定义马卡龙圆角分类下拉选择器 -->
			<div class="sidebar-category-dropdown" data-sidebar-category-dropdown>
				<button
					type="button"
					class="sidebar-dropdown-trigger"
					data-dropdown-trigger
					aria-haspopup="listbox"
					aria-expanded="false"
					title="按分类筛选文章"
				>
					<span class="dropdown-trigger-text" data-dropdown-text>全部分类</span>
					<Icon name="chevron-down" class="dropdown-trigger-icon" />
				</button>
				<div class="sidebar-dropdown-panel" data-dropdown-panel role="listbox" hidden>
					<button
						type="button"
						class="sidebar-dropdown-option is-selected"
						role="option"
						data-value="all"
						aria-selected="true"
					>
						<span class="dropdown-option-label">全部分类</span>
						<span class="dropdown-option-badge">{posts.length}</span>
					</button>
					{
						categories.map((cat) => {
							const count = posts.filter((p) => p.data.category === cat).length;
							return (
								<button
									type="button"
									class="sidebar-dropdown-option"
									role="option"
									data-value={cat}
									aria-selected="false"
								>
									<span class="dropdown-option-label">{cat}</span>
									<span class="dropdown-option-badge">{count}</span>
								</button>
							);
						})
					}
				</div>
			</div>

			<button
				class="sidebar-collapse-btn"
				type="button"
				data-sidebar-collapse
				aria-label="收起文章侧栏"
				title="收起文章列表侧栏"
			>
				<Icon name="chevron-left" />
			</button>
		</div>
	</div>

	<ul class="sidebar-articles-list" data-article-nav-list>
		{
			posts.map((post) => {
				const isCurrent = post.id === currentSlug;
				return (
					<li class="sidebar-article-wrapper" data-sidebar-item data-sidebar-category={post.data.category}>
						<a
							href={`/articles/${post.id}/`}
							class:list={['sidebar-article-link', { 'is-current': isCurrent }]}
							aria-current={isCurrent ? 'page' : undefined}
						>
							<div class="sidebar-article-meta">
								<span class="badge badge-sm">{post.data.category}</span>
								<time class="sidebar-article-time">{formatDate(post.data.date)}</time>
							</div>
							<span class="sidebar-article-title">{post.data.title}</span>
						</a>
					</li>
				);
			})
		}
	</ul>
	<p class="sidebar-empty-hint" data-sidebar-empty hidden>该分类下暂无文章</p>
</aside>

