---
// 首页“文章”区块：只放最新几篇，全部文章和分类筛选在 /articles/
import type { CollectionEntry } from 'astro:content';
import ArticleList from './ArticleList.astro';

interface Props {
	/** 已按日期从新到旧排好序 */
	articles: CollectionEntry<'articles'>[];
}

const HOME_LIMIT = 3;
const { articles } = Astro.props;
---

<section id="articles" class="section wrap reveal">
	<div class="section-head">
		<div>
			<p class="kicker">03</p>
			<h2>文章 / Articles</h2>
		</div>
		<a class="section-more" href="/articles/">全部文章 ({articles.length}) <span aria-hidden="true">→</span></a>
	</div>
	<ArticleList articles={articles.slice(0, HOME_LIMIT)} />
</section>
