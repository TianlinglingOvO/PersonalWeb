---
import { render, type CollectionEntry } from 'astro:content';

interface Props {
	timeline: CollectionEntry<'timeline'>[];
}

const { timeline } = Astro.props;

const MOBILE_OPEN_YEARS = 2; // 手机端默认展开的年份组数（Future + 最新一年），其余折叠

const items = await Promise.all(
	timeline.map(async (item) => {
		const { Content } = await render(item);
		const year = item.data.isFuture ? 'Future' : item.data.date.slice(0, 4);
		return { item, Content, year };
	}),
);

const years = [...new Set(items.map(({ year }) => year))];
const yearCount = (year: string) => items.filter((i) => i.year === year).length;

// 桌面端蛇形排布：偶数行从左往右、奇数行从右往左，行尾向下拐弯接到下一行。
// 同时算出 4 列（宽屏）与 3 列（窄桌面）两套位置，由 CSS 媒体查询选用。
const snake = (i: number, cols: number) => {
	const row = Math.floor(i / cols);
	const pos = i % cols;
	const rtl = row % 2 === 1;
	const isLast = i === items.length - 1;
	const flags = [rtl && 'rtl', !isLast && pos === cols - 1 && 'turn', isLast && 'last'].filter(Boolean).join(' ');
	return { row: row + 1, col: rtl ? cols - pos : pos + 1, pos, flags };
};
---

<section id="timeline" class="section wrap timeline-section" data-timeline>
	<div class="section-head reveal">
		<div>
			<p class="kicker">02</p>
			<h2>历程 / 成长足迹 / Timeline</h2>
		</div>
	</div>

	<div class="timeline-items">
		{
			items.map(({ item, Content, year }, index) => {
				const s4 = snake(index, 4);
				const s3 = snake(index, 3);
				const isYearStart = index === 0 || items[index - 1].year !== year;
				const open = years.indexOf(year) < MOBILE_OPEN_YEARS;
				return (
					<div
						class:list={[
							'timeline-rail-item reveal',
							{
								'is-highlight': item.data.isHighlight,
								'is-future': item.data.isFuture,
								'is-folded': !open,
							},
						]}
						style={`--r4:${s4.row};--c4:${s4.col};--p4:${s4.pos};--r3:${s3.row};--c3:${s3.col};--p3:${s3.pos}`}
						data-s4={s4.flags || undefined}
						data-s3={s3.flags || undefined}
						data-timeline-item
						data-year={year}
						data-year-start={isYearStart ? '' : undefined}
					>
						{isYearStart && (
							<button
								type="button"
								class="timeline-year-label"
								data-timeline-year-toggle={year}
								aria-expanded={String(open)}
							>
								<span>{year}</span>
								<span class="timeline-year-count">{yearCount(year)} 条</span>
							</button>
						)}
						<div class="timeline-band" aria-hidden="true">
							<span class="timeline-node">
								{item.data.isFuture ? (
									<svg class="timeline-node-star" viewBox="0 0 24 24">
										<polygon points="12.0,2.8 14.47,8.6 20.75,9.16 15.99,13.3 17.41,19.44 12.0,16.2 6.59,19.44 8.01,13.3 3.25,9.16 9.53,8.6" />
									</svg>
								) : (
									<span class="timeline-node-dot" />
								)}
							</span>
							<span class="timeline-stem" />
						</div>
						<div class="timeline-card-slot">
							<article class="timeline-micro-card card">
								<div class="timeline-card-header">
									<span class="timeline-date-badge">{item.data.date}</span>
									<span class="timeline-tag-badge">{item.data.tag}</span>
								</div>
								<h3 class="timeline-card-title">{item.data.title}</h3>
								<div class="timeline-card-desc">
									<Content />
								</div>
								{item.data.links.length > 0 && (
									<div class="timeline-card-links">
										{item.data.links.map((link) => (
											<a
												href={link.href}
												class="timeline-link-btn"
												target={link.isExternal ? '_blank' : undefined}
												rel={link.isExternal ? 'noopener noreferrer' : undefined}
											>
												{link.label}
											</a>
										))}
									</div>
								)}
							</article>
						</div>
					</div>
				);
			})
		}
	</div>
</section>
