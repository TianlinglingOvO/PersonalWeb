---
import type { CollectionEntry } from 'astro:content';
import { site } from '../lib/site';
import ThemeImage from './ThemeImage.astro';

interface Props {
	latest?: CollectionEntry<'articles'>;
}

const { latest } = Astro.props;
---

<section id="top" class="hero wrap">
	<div class="hero-copy">
		<img class="avatar" src={site.avatar} alt={`${site.name} 的头像`} width="88" height="88" fetchpriority="high" decoding="async" />
		<p class="eyebrow">{site.eyebrow}</p>
		<h1>{site.name}</h1>
		<p class="tagline">{site.tagline}</p>
		<div class="hero-actions">
			<a class="btn btn-primary" href="/#about">了解我</a>
			<a class="btn btn-ghost" href="/#timeline">看历程</a>
			<a class="btn btn-ghost" href="/#connect">联系我</a>
		</div>
		{
			latest && (
				<a class="hero-latest" href={`/articles/${latest.id}/`}>
					<span class="hero-latest-label"><span class="hero-latest-dot" aria-hidden="true"></span>最近更新</span>
					<span class="hero-latest-title">{latest.data.title}</span>
					<span class="hero-latest-arrow" aria-hidden="true">→</span>
				</a>
			)
		}
	</div>
	<div class="hero-art">
		<ThemeImage place="hero" priority />
		{/* 首屏插画：绘制前把当前主题那张改成立即加载，比懒加载早开始下载；另一套主题的仍是懒加载，不会被下载 */}
		<script is:inline data-astro-rerun>
			document
				.querySelectorAll('.hero-art img[data-theme-only="' + document.documentElement.dataset.theme + '"]')
				.forEach((img) => (img.loading = 'eager'));
		</script>
	</div>
</section>
