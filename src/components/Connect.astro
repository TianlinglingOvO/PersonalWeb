---
import { site, social, type SocialItem } from '../lib/site';
import Icon from './Icon.astro';

function hint(item: SocialItem) {
	if (item.action === 'copy') return '点击复制';
	if (item.action === 'qr') return '展开查看二维码';
	return '打开主页';
}
---

<section id="connect" class="section wrap reveal">
	<div class="section-head">
		<div>
			<p class="kicker">05</p>
			<h2>联系我</h2>
		</div>
	</div>
	<div class="split">
		<div>
			<div class="contact-grid">
				{
					social.primary.map((item) => {
						if (item.action === 'qr') {
							return (
								<details class="card contact-card contact-expand">
									<summary class="contact-summary">
										<span class="contact-main">
											<Icon name={item.id} />
											<span class="contact-id">{item.label}</span>
										</span>
										<span class="contact-action">{hint(item)}</span>
									</summary>
									<div class="contact-panel">
										{item.qr && (
											<div class="qr contact-qr">
												<img
													src={item.qr}
													alt={`${item.label}占位二维码`}
													width="220"
													height="220"
												/>
											</div>
										)}
										<div class="contact-id-row">
											<code class="contact-value">{item.value}</code>
											<button class="btn btn-ghost btn-sm" type="button" data-copy={item.value}>
												复制 ID
											</button>
										</div>
									</div>
								</details>
							);
						}
						if (item.action === 'link' && item.href) {
							return (
								<a
									class="card contact-card contact-link"
									href={item.href}
									target="_blank"
									rel="noopener noreferrer"
									aria-label={`在新标签打开 ${item.label}`}
								>
									<span class="contact-main">
										<Icon name={item.id} />
										<span class="contact-id">{item.label}</span>
									</span>
									<span class="contact-value">{item.value}</span>
									<span class="contact-action">{hint(item)}</span>
								</a>
							);
						}
						return (
							<button
								class="card contact-card contact-copy"
								type="button"
								data-copy={item.value}
								aria-label={`复制${item.label} ${item.value}`}
							>
								<span class="contact-main">
									<Icon name={item.id} />
									<span class="contact-id">{item.label}</span>
								</span>
								<span class="contact-value">{item.value}</span>
								<span class="contact-action">{hint(item)}</span>
							</button>
						);
					})
				}
			</div>
		</div>
		<div class="side-art">
			<img src={site.connectImage} alt={site.connectImageAlt} width="990" height="1400" />
		</div>
	</div>
</section>
