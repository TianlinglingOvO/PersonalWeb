---
import { site, social, type SocialGroup, type SocialItem } from '../lib/site';
import Icon from './Icon.astro';

const groups: { id: SocialGroup; title: string }[] = [
	{ id: 'im', title: '社交账号' },
	{ id: 'social', title: '海外账号' },
	{ id: 'dev', title: '其他方式' },
];

function itemsIn(group: SocialGroup) {
	return social.primary.filter((item) => item.group === group);
}

function hint(item: SocialItem) {
	return item.action === 'copy' ? '点击复制' : '打开主页';
}
---

<section id="connect" class="section wrap reveal">
	<div class="section-head">
		<div>
			<p class="kicker">05</p>
			<h2>联系我 / Connect With Me</h2>
		</div>
	</div>
	<div class="split">
		<div class="contact-groups">
			{
				groups.map((group) => (
					<div class="contact-group">
						<p class="contact-group-title">{group.title}</p>
						<div class="contact-grid">
							{itemsIn(group.id).map((item) =>
								item.action === 'link' && item.href ? (
									<a
										class="card contact-card contact-link"
										href={item.href}
										target="_blank"
										rel="noopener noreferrer"
										aria-label={`在新标签打开 ${item.label}`}
									>
										<span class="contact-main">
											<Icon name={item.id} />
											<span class="contact-id">{item.label}</span>
										</span>
										<span class="contact-value"><!--email_off-->{item.value}<!--/email_off--></span>
										<span class="contact-action">{hint(item)}</span>
									</a>
								) : (
									<button
										class="card contact-card contact-copy"
										type="button"
										data-copy={item.value}
										aria-label={`复制${item.label} ${item.value}`}
									>
										<span class="contact-main">
											<Icon name={item.id} />
											<span class="contact-id">{item.label}</span>
										</span>
										<span class="contact-value"><!--email_off-->{item.value}<!--/email_off--></span>
										<span class="contact-action">{hint(item)}</span>
									</button>
								),
							)}
						</div>
					</div>
				))
			}
		</div>
		<div class="side-art">
			<img src={site.connectImage} alt={site.connectImageAlt} width="990" height="1400" />
		</div>
	</div>
</section>
