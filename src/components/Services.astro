---
import { render, type CollectionEntry } from 'astro:content';

interface Props {
	services: CollectionEntry<'services'>[];
}

const { services } = Astro.props;
const rendered = await Promise.all(
	services.map(async (service) => ({
		service,
		Content: (await render(service)).Content,
	})),
);
---

<section id="services" class="section wrap reveal">
	<div class="section-head">
		<div>
			<p class="kicker">04</p>
			<h2>服务 / Services</h2>
		</div>
	</div>
	<div class="card-grid services-grid" data-stagger>
		{
			rendered.map(({ service, Content }) => (
				<article class="card service-card">
					<h3>{service.data.title}</h3>
					<p>{service.data.summary}</p>
					<details>
						<summary>展开说明</summary>
						<div class="prose">
							<Content />
							<a class="service-cta" href={service.data.ctaHref}>
								{service.data.ctaLabel} <span aria-hidden="true">→</span>
							</a>
						</div>
					</details>
				</article>
			))
		}
	</div>
</section>
