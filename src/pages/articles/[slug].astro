---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { formatDate, site } from '../../lib/site';

export async function getStaticPaths() {
	const posts = await getCollection('articles');
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post },
	}));
}

interface Props {
	post: CollectionEntry<'articles'>;
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={`${post.data.title} · ${site.name}`} description={post.data.description}>
	<article class="article-page wrap-narrow">
		<a class="back-link" href="/#articles"><Icon name="arrow" /> 返回首页</a>
		<p class="meta">
			<span class="badge">{post.data.category}</span>
			{formatDate(post.data.date)}
		</p>
		<h1>{post.data.title}</h1>
		<div class="prose">
			<Content />
		</div>
	</article>
</BaseLayout>
