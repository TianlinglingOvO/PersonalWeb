---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import ArticleSidebarNav from '../../components/ArticleSidebarNav.astro';
import Comments from '../../components/Comments.astro';
import { getSortedArticles } from '../../lib/articles';
import { formatDate, readingMinutes, site } from '../../lib/site';

export async function getStaticPaths() {
	const posts = await getSortedArticles();
	const timeline = await getCollection('timeline');
	return posts.map((post, index) => ({
		params: { slug: post.id },
		props: {
			post,
			allPosts: posts,
			prevPost: index < posts.length - 1 ? posts[index + 1] : null,
			nextPost: index > 0 ? posts[index - 1] : null,
			// 时间线上关联了这篇文章的节点（节点 frontmatter 的 article 字段）
			timelineRefs: timeline.filter((item) => item.data.article === post.id),
		},
	}));
}

interface Props {
	post: CollectionEntry<'articles'>;
	allPosts: CollectionEntry<'articles'>[];
	prevPost?: CollectionEntry<'articles'> | null;
	nextPost?: CollectionEntry<'articles'> | null;
	timelineRefs: CollectionEntry<'timeline'>[];
}

const { post, allPosts, prevPost, nextPost, timelineRefs } = Astro.props;
const { Content, headings } = await render(post);
const filteredHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

<BaseLayout title={`${post.data.title} · ${site.name}`} description={post.data.description} type="article" publishedTime={post.data.date}>
	<div class="reading-progress" data-reading-progress aria-hidden="true"><span></span></div>
	<div class="article-layout-container wrap-wide" data-article-layout>
		<!-- 左侧：文章快速切换侧栏 (桌面宽屏) -->
		<ArticleSidebarNav currentSlug={post.id} posts={allPosts} class="desktop-sidebar" />

		<!-- 侧栏收起时在最左侧浮现的展开胶囊按钮 -->
		<button
			class="sidebar-float-expand-btn desktop-sidebar"
			type="button"
			data-sidebar-expand
			aria-label="展开文章侧栏"
			title="展开文章列表侧栏"
		>
			<Icon name="chevron-right" />
			<span>文章列表</span>
		</button>

		<!-- 中间：文章主体内容 -->
		<div class="article-main-column">
			<article class="article-page">
				<a class="back-link" href="/#articles"><Icon name="arrow" /> 返回首页</a>
				<p class="meta">
					<span class="badge">{post.data.category}</span>
					{formatDate(post.data.date)} · 约 {readingMinutes(post.body)} 分钟
					<span class="view-count" data-views={post.id} data-views-count hidden>{' · '}<Icon name="eye" class="view-count-icon" /><span data-views-num /></span>
				</p>
				<h1>{post.data.title}</h1>
				<p class="article-lead">{post.data.description}</p>

				<!-- 移动端 / 中屏折叠目录 -->
				{
					filteredHeadings.length > 0 && (
						<details class="mobile-toc-details">
							<summary class="mobile-toc-summary">
								<span class="mobile-toc-summary-left">
									<Icon name="list" />
									<span>本文目录</span>
								</span>
								<Icon name="chevron-down" class="mobile-toc-chevron" />
							</summary>
							<TableOfContents headings={headings} class="mobile-toc-inner" />
						</details>
					)
				}

				<div class="prose">
					<Content />
				</div>

				{
					timelineRefs.length > 0 && (
						<p class="article-timeline-ref">
							<Icon name="history" class="article-timeline-ref-icon" />
							<span>这篇文章收录在我的成长历程里：</span>
							{timelineRefs.map((item) => (
								<a href={`/#tl-${item.id}`}>
									{item.data.date} · {item.data.title} →
								</a>
							))}
						</p>
					)
				}

				<nav class="article-nav" aria-label="文章上下篇导航">
					{
						prevPost ? (
							<a class="article-nav-card prev" href={`/articles/${prevPost.id}/`}>
								<span class="nav-direction">← 上一篇</span>
								<span class="nav-title">{prevPost.data.title}</span>
							</a>
						) : (
							<div />
						)
					}
					{
						nextPost ? (
							<a class="article-nav-card next" href={`/articles/${nextPost.id}/`}>
								<span class="nav-direction">下一篇 →</span>
								<span class="nav-title">{nextPost.data.title}</span>
							</a>
						) : (
							<div />
						)
					}
				</nav>
			</article>

			<Comments slug={post.id} />
		</div>

		<!-- 右侧：目录大纲树 (桌面宽屏) -->
		<aside class="article-toc-column desktop-toc" aria-label="文章目录侧栏">
			<TableOfContents headings={headings} />
		</aside>
	</div>
</BaseLayout>
