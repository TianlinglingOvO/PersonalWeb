---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleList from '../../components/ArticleList.astro';
import Icon from '../../components/Icon.astro';
import { getSortedArticles } from '../../lib/articles';
import { site } from '../../lib/site';

const articles = await getSortedArticles();
---

<BaseLayout title={`文章 · ${site.name}`} description={`${site.name} 的全部文章，可以按分类筛选。`}>
	<section class="section wrap">
		<a class="back-link" href="/#articles"><Icon name="arrow" /> 返回首页</a>
		<div class="section-head">
			<div>
				<p class="eyebrow">文章</p>
				<h1 class="page-title">全部文章</h1>
			</div>
		</div>
		<ArticleList articles={articles} filterable />
	</section>
</BaseLayout>
