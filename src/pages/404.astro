---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../lib/site';
---

<BaseLayout title={`页面不存在 · ${site.name}`} description="这个地址没有对应的页面。">
	<div class="not-found wrap">
		<img src={site.notFoundImage} alt={site.notFoundImageAlt} width="280" height="396" loading="lazy" />
		<p class="eyebrow">404</p>
		<h1>这一页还没有内容</h1>
		<p class="tagline">可能是链接写错了，或这篇文章还没放上来。</p>
		<p>
			<a class="btn btn-primary" href="/">回到首页</a>
		</p>
	</div>
</BaseLayout>
