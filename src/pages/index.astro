---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Timeline from '../components/Timeline.astro';
import Articles from '../components/Articles.astro';
import Services from '../components/Services.astro';
import Connect from '../components/Connect.astro';

const aboutEntry = (await getCollection('about'))[0];
if (!aboutEntry) throw new Error('缺少 content/about.md');

// 时间正序：从出生（order 最小）开始，Future 永远排在最后
const timeline = (await getCollection('timeline')).sort((a, b) => {
	if (a.data.isFuture !== b.data.isFuture) return a.data.isFuture ? 1 : -1;
	if (a.data.order !== b.data.order) return a.data.order - b.data.order;
	return a.data.date.localeCompare(b.data.date);
});
const articles = (await getCollection('articles')).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout>
	<div class="bg-wash">
		<Hero latest={articles[0]} />
		<About entry={aboutEntry} />
	</div>
	<Timeline timeline={timeline} />
	<Articles articles={articles} />
	<Services services={services} />
	<Connect />
</BaseLayout>
