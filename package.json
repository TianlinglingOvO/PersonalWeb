  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.6",
    "astro": "^7.4.5"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@cloudflare/workers-types": "^5.20261104.1",
    "typescript": "^6.0.3",
    "wrangler": "^4.158.0"
  }
}
