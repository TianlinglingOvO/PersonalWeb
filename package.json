  },
  "allowScripts": {
    "esbuild": true,
    "workerd": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^5.20261007.1",
    "typescript": "^6.0.3",
    "wrangler": "^4.148.0"
  }
}
